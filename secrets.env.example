# Node secrets, shared by every node (mgmt + storage).
#
# This starter provisions via SSM, so these values are stored in an SSM
# SecureString (secrets_ssm_path) that the nodes fetch at provision time:
#   cp secrets.env.example secrets.env   # fill in real values (git-ignored)
#   aws ssm put-parameter --type SecureString \
#     --name /mgx/main/secrets --value file://secrets.env
#
# They are merged over the baked mgx-env (secrets win) and are NOT baked into
# the AMI.

# Cassandra username / password
CASS_USER=<CASS_USER>
CASS_PASSWD=<CASS_PASSWD>

# mgx gateway / node X-API keys.
MGX_GW_X_API_KEY="<X_API_KEY>"
MGX_X_API_KEY="<X_API_KEY>"

# mgx gateway admin password.
MGX_GW_ADMIN_PASSWD=<MGX_GW_ADMIN_PASSWD>

# Grafana admin user / password (used when metrics are enabled).
GRAFANA_USER=<GRAFANA_USER>
GRAFANA_PASSWD=<GRAFANA_PASSWD>
